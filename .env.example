# Copiar a .env para cambiar valores de docker compose (opcional).
GO_PORT=8081
SCALA_PORT=8080
PROLOG_PORT=8082
CONSOLE_PORT=5173
# URL accesible desde el navegador; definir solo si no coincide con los puertos anteriores.
# VITE_GO_URL=http://localhost:8081
# VITE_SCALA_URL=http://localhost:8080
# VITE_PROLOG_URL=http://localhost:8082
# true omite las pruebas dentro de las imágenes (el CI ya las ejecuta antes).
SKIP_TESTS=false
# Registro y etiqueta de las imágenes (docker-compose.release.yml usa ghcr.io por defecto).
# IMAGE_REGISTRY=ghcr.io/brxck2203/lenguajesproject2
# GAMESTATS_TAG=latest
